{
  "name": "harmonic-lens",
  "version": "0.1.0",
  "description": "Live vocal harmonic visualizer.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.mjs",
  "desktopName": "harmonic-lens",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:desktop": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron . --dev-server-url=http://127.0.0.1:5173\"",
    "praat:fixtures": "node scripts/generate-praat-golden-fixtures.mjs",
    "praat:fixtures:check": "node scripts/generate-praat-golden-fixtures.mjs --check",
    "praat:golden:native": "./scripts/praat-golden-native.sh",
    "praat:golden:record": "node scripts/record-praat-golden-reference.mjs analysis-output/praat-reference tests/praat-golden/native-oracle.json",
    "praat:golden:compare": "node scripts/compare-praat-golden.mjs",
    "praat:wasm:spectrogram:export": "node scripts/export-praat-wasm-spectrogram.mjs",
    "praat:wasm:probe": "./scripts/praat-wasm-wrapper.sh && node scripts/praat-wasm-wrapper-test.mjs",
    "praat:wasm:pitch-harmonicity": "./scripts/praat-wasm-pitch-harmonicity.sh && node scripts/praat-wasm-pitch-harmonicity-test.mjs",
    "praat:wasm:stage": "node scripts/stage-praat-wasm.mjs",
    "praat:wasm:stage:check": "node scripts/stage-praat-wasm.mjs --check",
    "praat:wasm:pitch-harmonicity:fixtures": "node scripts/export-praat-wasm-pitch-harmonicity-fixtures.mjs",
    "praat:wasm:pitch-harmonicity:compare": "npm run praat:wasm:pitch-harmonicity && npm run praat:wasm:pitch-harmonicity:fixtures && node scripts/compare-praat-golden.mjs -- --candidate analysis-output/praat-wasm-pitch-harmonicity --analysis pitch && node scripts/compare-praat-golden.mjs -- --candidate analysis-output/praat-wasm-pitch-harmonicity --analysis harmonicity",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run praat:wasm:stage:check && tsc && vite build && vite build --config vite.runtime.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac zip --publish never",
    "package:win": "npm run build && electron-builder --win portable --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "org.harmoniclens.app",
    "productName": "Harmonic Lens",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Harmonic Lens uses your microphone to render a local live spectrogram."
      }
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "syncDesktopName": true
    }
  }
}
